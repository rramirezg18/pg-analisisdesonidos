# Copia este archivo a k8s/backend-secret.env (está en .gitignore) y llénalo.
# kustomize lo convierte en el Secret "backend-secret".
# Genera SECRET_KEY con: python3 -c "import secrets; print(secrets.token_hex(32))"
# Contraseña de PostgreSQL: usa solo letras y números (va dentro de la URL de conexión).
# Genérala con: python3 -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=CAMBIAME
SECRET_KEY=CAMBIAME-usa-un-valor-aleatorio-largo
ADMIN_API_KEY=
# Correos (separados por coma) con acceso al panel /admin.
ADMIN_EMAILS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
