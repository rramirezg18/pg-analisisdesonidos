# Copia este archivo a .env y ajusta los valores.
# Ruta absoluta dentro del contenedor; /app/data se persiste en un volumen.
DATABASE_URL=sqlite:////app/data/sonidos_motos.db

# Seguridad / JWT
# Genera un valor con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAME-usa-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Clave para escribir el catálogo (POST /marcas, /modelos, /modelos-cnn y activar CNN)
# con el header X-Admin-Key. Vacía = esas operaciones quedan deshabilitadas.
ADMIN_API_KEY=

# Correos (separados por coma) que pueden entrar al panel de investigación (/admin).
ADMIN_EMAILS=

# Swagger en /api/docs. Dejar en false en producción (docker-compose.local.yml lo activa).
HABILITAR_DOCS=false

# Máximo de análisis de audio por usuario y por minuto (responde 429 al excederlo).
ANALISIS_POR_MINUTO=10

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=https://talleraguilasonidos.duckdns.org,http://localhost,http://localhost:5173

# GitHub OAuth (crea una OAuth App en https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://talleraguilasonidos.duckdns.org/api/auth/github/callback

# Google OAuth (crea un "ID de cliente de OAuth" en https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://talleraguilasonidos.duckdns.org/api/auth/google/callback

FRONTEND_URL=https://talleraguilasonidos.duckdns.org

# --- Para LOCALHOST cambia estas URLs (y regístralas en las apps OAuth) ---
# CORS_ORIGINS=http://localhost,http://localhost:5173
# GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback
# GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
# FRONTEND_URL=http://localhost
