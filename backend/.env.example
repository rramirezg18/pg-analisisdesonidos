# Copia este archivo a .env y ajusta los valores.
# Ruta absoluta dentro del contenedor; /app/data se persiste en un volumen.
DATABASE_URL=sqlite:////app/data/sonidos_motos.db

# Seguridad / JWT
# Genera un valor con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAME-usa-un-valor-aleatorio-largo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost,http://localhost:5173

# GitHub OAuth (crea una OAuth App en https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback
FRONTEND_URL=http://localhost
